%==============================================================================
%  estilo-avaliacao.sty
%  Estilo das avaliações do curso de Aprendizado de Máquina --- a lista de
%  revisão e as provas teóricas, que ficam em avaliacoes/, na raiz.
%
%      \usepackage{../recursos/latex/estilo-avaliacao}            % enunciado
%      \usepackage[gabarito]{../recursos/latex/estilo-avaliacao}  % com soluções
%
%  POR QUE ESTE ARQUIVO NÃO CARREGA O estilo-lista.sty
%  ---------------------------------------------------
%  O estilo-lista.sty carrega o estilo-notas por "../../recursos/latex/", um
%  caminho relativo ao DIRETÓRIO DE COMPILAÇÃO (não ao .sty). Isso funciona para
%  as listas porque toda aula está exatamente dois níveis abaixo da raiz
%  (aulas/NN-tema/). A pasta avaliacoes/ está a UM nível, e ali aquele "../../"
%  sai do repositório.
%
%  Por isso as ~30 linhas de que precisávamos do estilo-lista.sty estão
%  DUPLICADAS aqui: a opção [gabarito], o ambiente exercicio e o ambiente
%  solucao. Elas são cópia fiel; se um dia mexerem num dos dois arquivos, o
%  outro precisa acompanhar.
%==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo-avaliacao}[2026/09/14 Estilo das avaliacoes de AM]

% ----- Opções do pacote -------------------------------------------------------
% [gabarito]: inclui os ambientes "solucao" e "criterio". Sem a opção, eles são
% descartados pelo comment.sty e nem chegam ao PDF.
\newif\ifgabarito\gabaritofalse
\DeclareOption{gabarito}{\gabaritotrue}
\ProcessOptions\relax

% Um ".." só --- ver o cabeçalho deste arquivo.
\RequirePackage[aluno]{../recursos/latex/estilo-notas}
\RequirePackage{comment}

% ----- Cabeçalho e rodapé -----------------------------------------------------
% Sobrescreve o das notas (estilo-notas já chamou \pagestyle{fancy}). O texto da
% direita é definido pelo documento, via \cabecalhorevisao ou \cabecalhoprova.
\fancyhead[L]{\small\itshape Aprendizado de Máquina}

% ----- Cabeçalho da lista de revisão ------------------------------------------
% \cabecalhorevisao{intervalo de aulas}{descrição do conteúdo}
\newcommand{\cabecalhorevisao}[2]{%
  \ifgabarito
    \fancyhead[R]{\small\itshape Lista de Revisão --- gabarito}%
  \else
    \fancyhead[R]{\small\itshape Lista de Revisão}%
  \fi
  \begin{center}
    {\Large\bfseries Lista de Revisão\ifgabarito\ --- Gabarito\fi}\\[0.4em]
    {\small\itshape Curso de Aprendizado de Máquina --- UFF}\\[0.2em]
    {\small\itshape Prof. Gabriel Sanfins}\\[0.2em]
    {\small Aulas #1 --- #2}
  \end{center}
  \vspace{0.5em}\hrule\vspace{1.2em}}

% ----- Cabeçalho da prova -----------------------------------------------------
% \cabecalhoprova[notação]{número}{intervalo de aulas}{descrição}{duração}{total}
% Produz o título e a caixa de instruções; no gabarito, a caixa dá lugar a um
% aviso ao professor. Não há campos de identificação, e o intervalo de aulas e a
% descrição não são impressos --- a prova não mostra as aulas nem o conteúdo.
% O argumento opcional é o texto do item "Notação" da caixa de instruções. Sem
% ele, sai a notação de regressão, \notacaoregressao, que é a da Avaliação
% Teórica 01; a 02, de classificação, passa a sua.
% O nome da prova, no título e no cabeçalho das páginas, é \tituloprova{número}.
% O padrão, "Avaliação Teórica #1", é o da 01 e da 02; a Verificação de Reposição
% e a Verificação Suplementar o redefinem antes de chamar \cabecalhoprova, com
% \renewcommand{\tituloprova}[1]{Verificação de Reposição (#1)}, por exemplo.
\newcommand{\notacaoregressao}{$(\X,Y)$ é um vetor aleatório com distribuição $P$;
            $r(\x)=\E[Y\mid\X=\x]$ é a função de regressão;
            $\Dados=\{(\X_i,Y_i)\}_{i=1}^n$ é a amostra de treino, i.i.d.;
            $p$ é o número de covariáveis; a perda é a quadrática, salvo
            indicação em contrário.}
\newcommand{\tituloprova}[1]{Avaliação Teórica #1}
\newcommand{\cabecalhoprova}[6][\notacaoregressao]{%
  \ifgabarito
    \fancyhead[R]{\small\itshape \tituloprova{#2} --- gabarito}%
  \else
    \fancyhead[R]{\small\itshape \tituloprova{#2}}%
  \fi
  \begin{center}
    {\Large\bfseries \tituloprova{#2}\ifgabarito\ --- Gabarito\fi}\\[0.3em]
    {\large Curso de Aprendizado de Máquina --- UFF}\\[0.2em]
    {\small\itshape Prof. Gabriel Sanfins}\\[0.2em]
  \end{center}
  \ifgabarito
    \vspace{0.4em}
    \begin{atencao}
      Documento do professor. As resoluções indicam o \emph{esperado}; argumentos
      equivalentes e corretos devem ser aceitos integralmente. Os pesos por item
      somam o valor da questão.
    \end{atencao}
  \else
    \begin{tcolorbox}[colback=cinzaclaro,colframe=azulufrj,boxrule=0.6pt,
                      left=8pt,right=8pt,top=6pt,bottom=6pt]
    \small
    \textbf{Instruções.}
    \begin{itemize}[leftmargin=1.3cm,nosep]
      \item Duração: \textbf{#5}. Prova individual e sem consulta.
      \item A prova vale \textbf{#6}; o valor de cada item está indicado ao lado.
      \item \textbf{Justifique todas as respostas.}
      \item Notação: #1
    \end{itemize}
    \end{tcolorbox}
  \fi
  \vspace{0.6em}}

% ----- Cabeçalho do trabalho prático ------------------------------------------
% \cabecalhotrabalho{número}{valor total}{prazo}
% O enunciado traz uma caixa com o que entregar e como; no gabarito, a caixa dá
% lugar a um aviso ao professor, como na prova.
\newcommand{\cabecalhotrabalho}[3]{%
  \ifgabarito
    \fancyhead[R]{\small\itshape Trabalho Prático #1 --- roteiro de correção}%
  \else
    \fancyhead[R]{\small\itshape Trabalho Prático #1}%
  \fi
  \begin{center}
    {\Large\bfseries Trabalho Prático #1\ifgabarito\ --- Roteiro de Correção\fi}\\[0.3em]
    {\large Curso de Aprendizado de Máquina --- UFF}\\[0.2em]
    {\small\itshape Prof. Gabriel Sanfins}\\[0.2em]
  \end{center}
  \ifgabarito
    \vspace{0.4em}
    \begin{atencao}
      Documento do professor. Os números das caixas de solução foram medidos no
      notebook de resolução, com as sementes do enunciado e o
      \texttt{scikit-learn}~1.9; outra versão, ou outra escolha razoável do
      aluno, desloca a terceira casa decimal e às vezes a segunda. O que se
      corrige é o \emph{raciocínio} --- a leitura do número, não o número.
    \end{atencao}
  \else
    \begin{tcolorbox}[colback=cinzaclaro,colframe=azulufrj,boxrule=0.6pt,
                      left=8pt,right=8pt,top=6pt,bottom=6pt]
    \small
    \textbf{Instruções.}
    \begin{itemize}[leftmargin=1.3cm,nosep]
      \item O trabalho é \textbf{individual} e vale \textbf{#2}; o valor de cada
            tarefa está indicado ao lado dela.
      \item Prazo de entrega: \textbf{#3}.
      \item Entrega: \textbf{um único notebook Jupyter} (\texttt{.ipynb}), com o
            código \emph{e} as respostas escritas, nas regras da
            Seção~\ref{sec:regras}.
      \item \textbf{Justifique todas as respostas.}
    \end{itemize}
    \end{tcolorbox}
  \fi
  \vspace{0.6em}}

% ----- Fonte única: lista de revisão e prova ----------------------------------
% O corpo de cada exercício mora em avaliacoes/exercicios/ex-NN-slug.tex e é
% incluído por \input pelos DOIS documentos. Assim é impossível que a prova e a
% lista divirjam no enunciado ou na solução de um exercício sorteado.
%
% O que difere entre os dois usos é só a pontuação por item, que a prova mostra e
% a lista não. O arquivo do exercício escreve \pts{1,0} antes do texto do item; o
% comando some na lista e vira "(1,0)" em negrito na prova.
%
% Os valores escritos nos arquivos somam 4,0 por exercício, o peso de uma questão
% nas provas de três questões. Numa prova de quatro questões, de 3,0 cada, a prova
% declara os valores de cada questão antes do \input dela, na ordem dos itens e
% separados por ponto e vírgula (a vírgula é a decimal):
%     \pontositens{0,9;0,7;0,6;0,8}
% e os \pts seguintes imprimem esses valores no lugar dos do arquivo. Faltar valor
% (mais itens que valores) ou sobrar valor (ao chegar à \questao seguinte ou ao fim
% do documento) é erro de compilação. Sem \pontositens, nada muda.
\newif\ifprova\provafalse
\newif\ifpts@lista\pts@listafalse
\def\pts@lista{}
\def\pts@pop#1;#2\@nil{\gdef\pts@valor{#1}\gdef\pts@lista{#2}}
\newcommand{\pts@confere}{%
  \ifpts@lista
    \ifx\pts@lista\@empty\else
      \PackageError{estilo-avaliacao}%
        {Sobram valores no \string\pontositens\space desta questao}%
        {Ha mais valores declarados que itens com \string\pts.}%
    \fi
    \global\pts@listafalse
  \fi}
\newcommand{\pontositens}[1]{\pts@confere\global\pts@listatrue\gdef\pts@lista{#1;}}
\newcommand{\pts}[1]{%
  \ifprova
    \ifpts@lista
      \ifx\pts@lista\@empty
        \PackageError{estilo-avaliacao}%
          {Faltam valores no \string\pontositens\space desta questao}%
          {Ha mais itens com \string\pts\space que valores declarados.}%
        \textbf{(#1)}\ %
      \else
        \expandafter\pts@pop\pts@lista\@nil\textbf{(\pts@valor)}\ %
      \fi
    \else
      \textbf{(#1)}\ %
    \fi
  \fi}
\AtEndDocument{\pts@confere}

% Ambiente dos itens (a), (b), ... --- idêntico nos dois documentos.
\newenvironment{itens}
  {\begin{enumerate}[label=\textbf{(\alph*)},leftmargin=1.1cm]}
  {\end{enumerate}}

% ----- Ambiente de exercício --------------------------------------------------
% \begin{exercicio}[título curto]  ...  \end{exercicio}
% Cópia do estilo-lista.sty. Contador contínuo no documento; \refstepcounter
% deixa \label/\ref funcionarem dentro do ambiente.
\newcounter{exercicio}
\NewDocumentEnvironment{exercicio}{o}{%
  \par\medskip\refstepcounter{exercicio}%
  \noindent
  {\bfseries\color{azulufrj}%
    Exercício~\theexercicio
    \IfValueT{#1}{ --- #1}%
  .}\enspace\ignorespaces
}{\par\medskip}

% ----- Questão de prova -------------------------------------------------------
% \questao{título}{valor} --- cabeçalho de cada questão da avaliação. Usa o mesmo
% contador do ambiente exercicio, e o incrementa ele próprio.
% O título pode ficar vazio, \questao{}{4,0 pontos}, para espelhar um exercício
% sem título na lista; aí o travessão também some.
% Não há marcador da aula de origem, de propósito: a prova não revela de que aula
% vem cada questão.
\newcommand{\questao}[2]{%
  \pts@confere
  \bigskip\par\refstepcounter{exercicio}\noindent
  \def\questao@titulo{#1}%
  {\large\bfseries\color{azulufrj}Questão~\theexercicio
    \ifx\questao@titulo\@empty\else\ --- #1\fi}%
  \hfill{\bfseries(#2)}\par
  \nopagebreak\vspace{0.3em}}

% ----- Ambiente de solução ----------------------------------------------------
% Cópia do estilo-lista.sty. Só existe com a opção [gabarito]; sem ela, o
% comment.sty descarta o corpo linha a linha --- por isso \begin{solucao} e
% \end{solucao} precisam ficar sozinhos na linha.
\ifgabarito
  \DeclareTColorBox{solucao}{o}{%
    enhanced, breakable, colback=verdeesc!5, colframe=verdeesc,
    coltitle=white, fonttitle=\bfseries, title={Solução\IfValueT{#1}{: #1}}}
\else
  \excludecomment{solucao}
\fi

% ----- Caixa de critério de correção ------------------------------------------
% Só no gabarito da prova. Mesma regra de linha do solucao.
\ifgabarito
  \newtcolorbox{criterio}{enhanced,breakable,colback=azulufrj!5,
    colframe=azulufrj,coltitle=white,fonttitle=\bfseries\small,
    title={Critério de correção (sugestão)},fontupper=\small,
    left=6pt,right=6pt,top=4pt,bottom=4pt}
\else
  \excludecomment{criterio}
\fi

\endinput
